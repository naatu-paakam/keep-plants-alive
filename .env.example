# ── Vertex AI mode (used in this project) ──────────────────────────────────────
# Local dev: point to the GCP service account JSON file (gitignored path)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-gcp-service-account.json
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-east5

# Netlify prod: paste the entire JSON file content as a single-line string
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Direct Anthropic API mode (alternative, if not using Vertex AI) ─────────────
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Feedback email (Resend — resend.com, free tier: 3k emails/month) ──────────
RESEND_API_KEY=re_your_resend_api_key_here
FEEDBACK_EMAIL=your_email@example.com

# All of the above are server-side only — set in .env.local locally or
# in the Netlify dashboard in production. Never commit real values.
